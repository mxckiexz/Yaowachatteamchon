# Copy this file to "server/.env" and fill in your own local values. Do NOT commit your real .env file.
# Local development uses server/.env. Cloud Run sets the same names; the secrets come from Secret Manager.

# PostgreSQL connection string. In the cloud it is a secret (Secret Manager: purchaseflow-database-url).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/purchaseflow?schema=public"

# Port the API listens on. Cloud Run sets it; the container default is 3000.
PORT=3000

# The one origin allowed to send state-changing requests (POST, PATCH, DELETE).
# Local: the Vite client. In the cloud: the service URL (deploy.sh sets it after the first deploy).
CLIENT_ORIGIN="http://localhost:5173"

# Password shared by the five seeded demo accounts (synthetic data, UAT in Lab 6).
# Local development: any value. In production the seed refuses the example value and anything under 12 characters,
# and the value comes from Secret Manager (purchaseflow-seed-password). Never put a real password here.
SEED_DEFAULT_PASSWORD="ChangeMe123!"

# Optional. The CPE334 course portal gives the migration job these two names instead (the seed accepts either form).
# DEMO_USER_PASSWORD is used for the requester and approver accounts and ADMIN_PASSWORD for the administrator account.
# If only ADMIN_PASSWORD is set, only the administrator is seeded. SEED_DEFAULT_PASSWORD wins over DEMO_USER_PASSWORD.
# DEMO_USER_PASSWORD="change-me-12-or-more-characters"
# ADMIN_PASSWORD="change-me-12-or-more-characters"

# Optional. Runtime mode: "production" in the cloud and in docker compose (secure cookies, create-only seed).
# NODE_ENV=development

# Optional. Folder with the built client for the API to serve. Set in the Docker image; leave unset locally (Vite serves the client).
# STATIC_DIR=/app/client/dist
