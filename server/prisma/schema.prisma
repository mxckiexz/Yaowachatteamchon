generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REQUESTER
  APPROVER
  ADMIN
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum HistoryAction {
  CREATED
  SUBMITTED
  RETURNED
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationType {
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
}

enum Category {
  EQUIPMENT
  SOFTWARE
  FURNITURE
  STATIONERY
  OTHER
}

model User {
  id                 Int               @id @default(autoincrement())
  name               String
  email              String            @unique
  passwordHash       String
  role               Role
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  sessions           Session[]
  requests           PurchaseRequest[]
  historyEntries     RequestHistory[]
  attachments        Attachment[]
  comments           Comment[]
  notifications      Notification[]    @relation("NotificationRecipient")
  actedNotifications Notification[]    @relation("NotificationActor")
}

model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model PurchaseRequest {
  id              Int              @id @default(autoincrement())
  requestNumber   String           @unique
  requesterId     Int
  itemName        String
  description     String
  quantity        Int
  unitPriceSatang Int
  totalSatang     BigInt
  reason          String           @default("")
  category        Category?
  status          RequestStatus    @default(DRAFT)
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  submittedAt     DateTime?
  decidedAt       DateTime?
  requester       User             @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  history         RequestHistory[]
  attachments     Attachment[]
  comments        Comment[]
  notifications   Notification[]

  @@index([requesterId])
  @@index([status, submittedAt])
}

model RequestHistory {
  id         Int             @id @default(autoincrement())
  requestId  Int
  actorId    Int
  action     HistoryAction
  fromStatus RequestStatus?
  toStatus   RequestStatus
  comment    String?
  createdAt  DateTime        @default(now())
  request    PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor      User            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

// F-09: files on a request (BR-22, BR-23). Select "content" only for a download.
model Attachment {
  id           Int             @id @default(autoincrement())
  requestId    Int
  fileName     String
  fileType     String
  sizeBytes    Int
  content      Bytes
  uploadedById Int
  createdAt    DateTime        @default(now())
  request      PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy   User            @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([requestId])
}

// F-10: comments on a request (BR-24, BR-25). Rows are only added, never changed by the application.
model Comment {
  id        Int             @id @default(autoincrement())
  requestId Int
  authorId  Int
  text      String
  createdAt DateTime        @default(now())
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User            @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([requestId])
}

// F-12: in-app notifications (BR-27, BR-28). Created only with a status change; only "readAt" changes afterwards.
// The message is not stored: the client builds it from the type, the actor and the request.
model Notification {
  id          Int              @id @default(autoincrement())
  recipientId Int
  requestId   Int
  actorId     Int
  type        NotificationType
  createdAt   DateTime         @default(now())
  readAt      DateTime?
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  actor       User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Restrict)
  request     PurchaseRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([requestId])
}
