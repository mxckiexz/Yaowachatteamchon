# Used by docker-compose.yml only. Copy to ".env" next to docker-compose.yml. Do NOT commit your real .env file.
# docker compose refuses to start without SEED_DEFAULT_PASSWORD (12+ characters, not the example value).
SEED_DEFAULT_PASSWORD="replace-with-12-or-more-characters"
# Optional overrides; the defaults are throw-away local values.
# POSTGRES_USER=purchaseflow
# POSTGRES_PASSWORD=purchaseflow
# POSTGRES_DB=purchaseflow
# CLIENT_ORIGIN=http://localhost:3000
# APP_PORT=3000   # port on your computer; CLIENT_ORIGIN follows it unless you set CLIENT_ORIGIN yourself
